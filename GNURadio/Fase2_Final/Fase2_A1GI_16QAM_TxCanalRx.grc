- name: captura_auto
  id: snippet
  parameters:
    alias: ''
    code: "# --- Guion automatico de pruebas y capturas (solo corre si modo_captura\
      \ == 1) ---\nimport os, json, math, traceback\nfrom PyQt5 import QtCore\nif\
      \ self.modo_captura:\n    self.resize(1900, 1150)\n    _dir = os.path.join(os.path.dirname(os.path.abspath(__file__)),\
      \ 'capturas')\n    os.makedirs(_dir, exist_ok=True)\n    _res = {'escenarios':\
      \ {}, 'barrido_muestreo': [], 'barrido_ber': [], 'alineacion': []}\n    _W =\
      \ {\n        'psd_tx_canal': self._psd_tx_canal_win, 'psd_beta': self._psd_beta_win,\n\
      \        'envolvente': self._envolvente_canal_win, 'const_canal': self._const_canal_win,\n\
      \        'ojo': self._ojo_filtro_acoplado_win, 'const_rx': self._const_rx_win,\n\
      \        'simbolos': self._simbolos_tx_rx_win, 'ber': self._ber_num_win, 'evm':\
      \ self._evm_num_win,\n    }\n    def _grab(nombre, clave):\n        _W[clave].grab().save(os.path.join(_dir,\
      \ nombre + '.png'))\n    def _guardar():\n        with open(os.path.join(_dir,\
      \ 'resultados.json'), 'w') as f:\n            json.dump(_res, f, indent=1)\n\
      \    def _bits():\n        return self.ber_promedio.nitems_read(0)\n    def\
      \ _esperar_bits(n):\n        n0 = _bits()\n        while _bits() - n0 < n:\n\
      \            yield\n    def _esperar_ms(ms):\n        t = QtCore.QElapsedTimer();\
      \ t.start()\n        while t.elapsed() < ms:\n            yield\n    def _conf(EsN0=30.0,\
      \ awgn=1, att=0.0, emi=0, isr=0.0, d=7, agc=1, ref=None):\n        self.set_EsN0_dB(EsN0);\
      \ self.set_awgn_on(awgn); self.set_atten_dB(att)\n        self.set_emi_on(emi);\
      \ self.set_emi_isr_dB(isr); self.set_d_muestreo(d); self.set_agc_on(agc)\n \
      \       if not agc:\n            self.rx_agc.set_gain(1.0)\n        if ref is\
      \ not None:\n            self.set_retardo_ref(ref)\n    def _medir(nombre, k=3,\
      \ extra=None):\n        yield from _esperar_bits(2 * self.ber_win)\n       \
      \ b, e = [], []\n        for i in range(k):\n            yield from _esperar_bits(self.ber_win)\n\
      \            b.append(self.probe_ber.level()); e.append(self.probe_evm.level())\n\
      \        r = dict(ber=sum(b) / k, ber_lecturas=b, evm_pct=sum(e) / k, bits=k\
      \ * self.ber_win,\n                 EsN0_dB=self.EsN0_dB, awgn_on=self.awgn_on,\
      \ atten_dB=self.atten_dB, emi_on=self.emi_on,\n                 emi_isr_dB=self.emi_isr_dB,\
      \ d_muestreo=self.d_muestreo, agc_on=self.agc_on,\n                 retardo_ref=self.retardo_ref,\
      \ noise_amp=self.noise_amp)\n        if extra:\n            r.update(extra)\n\
      \        _res['escenarios'][nombre] = r\n        _guardar()\n        return\
      \ r\n    def _guion():\n        yield from _esperar_ms(3000)\n        t0 = QtCore.QElapsedTimer();\
      \ t0.start(); n0 = _bits()\n        yield from _esperar_ms(2000)\n        _res['bits_por_segundo_simulados']\
      \ = (_bits() - n0) / (t0.elapsed() / 1000.0)\n        # 1) Alineacion de la\
      \ referencia (canal ideal, muestreo d=7)\n        _conf(awgn=0, d=7, agc=1)\n\
      \        mejor, mejor_ber = 11, 1.0\n        for ref in range(6, 17):\n    \
      \        self.set_retardo_ref(ref)\n            yield from _esperar_bits(3 *\
      \ self.ber_win)\n            v = self.probe_ber.level()\n            _res['alineacion'].append([ref,\
      \ v])\n            if v < mejor_ber:\n                mejor, mejor_ber = ref,\
      \ v\n        _res['retardo_ref_optimo'] = mejor\n        _guardar()\n      \
      \  # 2) Canal ideal\n        _conf(awgn=0, d=7, agc=1, ref=mejor)\n        yield\
      \ from _medir('ideal', k=3)\n        yield from _esperar_ms(1500)\n        for\
      \ c in ['psd_tx_canal', 'psd_beta', 'envolvente', 'const_canal', 'ojo', 'const_rx',\
      \ 'simbolos', 'ber', 'evm']:\n            _grab('ideal_' + c, c)\n        self.grab().save(os.path.join(_dir,\
      \ 'ventana_ideal.png'))\n        # 3) Barrido del instante de muestreo (canal\
      \ ideal)\n        for d in range(8):\n            mejor_d = None\n         \
      \   for ref in (mejor - 1, mejor, mejor + 1):\n                _conf(awgn=0,\
      \ d=d, agc=1, ref=ref)\n                r = yield from _medir('muestreo_d%d_ref%d'\
      \ % (d, ref), k=2)\n                if mejor_d is None or r['ber'] < mejor_d[1]:\n\
      \                    mejor_d = (ref, r['ber'], r['evm_pct'])\n            _res['barrido_muestreo'].append(dict(d=d,\
      \ ref=mejor_d[0], ber=mejor_d[1], evm_pct=mejor_d[2]))\n            _guardar()\n\
      \            if d in (0, 3, 6):\n                _conf(awgn=0, d=d, agc=1, ref=mejor_d[0])\n\
      \                yield from _esperar_bits(2 * self.ber_win)\n              \
      \  yield from _esperar_ms(1200)\n                _grab('muestreo_d%d_const_rx'\
      \ % d, 'const_rx')\n        # 4) LOS nominal (Es/N0 = 30 dB)\n        _conf(EsN0=30,\
      \ d=7, ref=mejor)\n        yield from _medir('los', k=3)\n        yield from\
      \ _esperar_ms(1500)\n        for c in ['psd_tx_canal', 'envolvente', 'const_canal',\
      \ 'ojo', 'const_rx', 'simbolos', 'ber', 'evm']:\n            _grab('los_' +\
      \ c, c)\n        # 5) EMI impulsiva (VFD/soldadura) sobre el LOS\n        for\
      \ isr in (-10.0, -5.0, 0.0, 5.0):\n            _conf(EsN0=30, emi=1, isr=isr,\
      \ d=7, ref=mejor)\n            yield from _medir('emi_isr%+d' % int(isr), k=5)\n\
      \        _conf(EsN0=30, emi=1, isr=0.0, d=7, ref=mejor)\n        yield from\
      \ _esperar_bits(2 * self.ber_win)\n        yield from _esperar_ms(1500)\n  \
      \      for c in ['psd_tx_canal', 'envolvente', 'const_canal', 'ojo', 'const_rx',\
      \ 'ber', 'evm']:\n            _grab('emi_' + c, c)\n        # 5b) AWGN con la\
      \ MISMA potencia media que EMI(0 dB) + fondo\n        Ps = self.E_pulso / self.Sps\n\
      \        duty = self.emi_rate * self.emi_dur\n        P_imp = duty * Ps * 10\
      \ ** (0.0 / 10)\n        P_bg = self.E_pulso / 10 ** (30.0 / 10)\n        Eq\
      \ = 10 * math.log10(self.E_pulso / (P_bg + P_imp))\n        _conf(EsN0=Eq, emi=0,\
      \ d=7, ref=mejor)\n        yield from _medir('awgn_equivalente_emi', k=3, extra=dict(EsN0_equivalente=Eq,\
      \ duty=duty))\n        yield from _esperar_ms(1200)\n        _grab('awgn_equiv_const_rx',\
      \ 'const_rx')\n        # 6) Sombra sin AGC (prueba fallida) y con AGC\n    \
      \    for att in (10.0, 15.0, 20.0):\n            _conf(EsN0=30, att=att, agc=0,\
      \ d=7, ref=mejor)\n            yield from _medir('sombra%d_sinAGC' % int(att),\
      \ k=2)\n            if att == 10.0:\n                yield from _esperar_ms(1200)\n\
      \                _grab('sombra10_sinAGC_const_rx', 'const_rx')\n        for\
      \ att in (10.0, 15.0, 20.0):\n            _conf(EsN0=30, att=att, agc=1, d=7,\
      \ ref=mejor)\n            yield from _medir('sombra%d_conAGC' % int(att), k=6\
      \ if att == 10.0 else 3)\n            yield from _esperar_ms(1200)\n       \
      \     _grab('sombra%d_conAGC_const_rx' % int(att), 'const_rx')\n           \
      \ if att == 15.0:\n                _grab('sombra15_conAGC_const_canal', 'const_canal')\n\
      \                _grab('sombra15_conAGC_psd', 'psd_tx_canal')\n        # 7)\
      \ Curva BER vs Eb/N0 medida en GNU Radio (AWGN, sin sombra ni EMI)\n       \
      \ for agc in (1, 0):\n            for EbN0 in (0, 2, 4, 6, 8, 10, 12):\n   \
      \             EsN0 = EbN0 + 10 * math.log10(self.bps)\n                _conf(EsN0=EsN0,\
      \ agc=agc, d=7, ref=mejor)\n                k = 3 if EbN0 <= 8 else 10\n   \
      \             r = yield from _medir('curva_agc%d_EbN0_%d' % (agc, EbN0), k=k)\n\
      \                _res['barrido_ber'].append(dict(agc=agc, EbN0_dB=EbN0, EsN0_dB=EsN0,\
      \ ber=r['ber'], evm_pct=r['evm_pct'], bits=r['bits']))\n                _guardar()\n\
      \        _conf(EsN0=30, d=7, ref=mejor)\n        _res['fin'] = True\n      \
      \  _guardar()\n    _g = _guion()\n    def _paso():\n        try:\n         \
      \   next(_g)\n        except StopIteration:\n            self._timer_captura.stop()\n\
      \            self.close()\n        except Exception:\n            self._timer_captura.stop()\n\
      \            with open(os.path.join(_dir, 'error.txt'), 'w') as f:\n       \
      \         f.write(traceback.format_exc())\n    self._timer_captura = QtCore.QTimer()\n\
      \    self._timer_captura.timeout.connect(_paso)\n    self._timer_captura.start(50)\n"
    comment: Guion automatico de pruebas
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 92.0]
    rotation: 0
    state: enabled
