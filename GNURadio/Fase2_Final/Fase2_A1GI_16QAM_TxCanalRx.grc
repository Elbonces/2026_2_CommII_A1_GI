options:
  parameters:
    author: Grupo A1-GI
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: '16QAM Tx-Canal-Rx: RRC, canal LOS/EMI/sombra, filtro acoplado, muestreo,
      AGC, decisor, BER/EVM'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Fase2_A1GI_16QAM_TxCanalRx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Fase 2 A1-GI: enlace 16-QAM Tx-Canal-Rx (inspeccion optica)'
    window_size: (1850,1100)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: E_pulso
  id: variable
  parameters:
    comment: ''
    value: sum(t*t for t in rrc_tx_taps)
  states:
