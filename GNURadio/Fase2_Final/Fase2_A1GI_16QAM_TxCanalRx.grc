- name: ruido_emi
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRuido impulsivo EMI (modelo Bernoulli-Gaussiano por rafagas).\n\
      \nRepresenta las rafagas de interferencia que producen los variadores de\nfrecuencia\
      \ (VFD) y equipos de soldadura de la celda: cada conmutacion genera\nuna rafaga\
      \ de ruido gaussiano complejo de duracion 'dur'. Las rafagas llegan\ncomo un\
      \ proceso de Poisson de tasa 'rate' (rafagas/s). Fuera de las rafagas\nla salida\
      \ es cero (el ruido de fondo lo aporta el bloque AWGN).\n\nParametros\n  samp_rate\
      \ : tasa de muestreo [muestras/s]\n  rate      : rafagas por segundo (~2*f_PWM\
      \ del variador)\n  dur       : duracion de cada rafaga [s]\n  amp       : amplitud\
      \ RMS compleja del ruido dentro de la rafaga\n  enable    : 1 = activo, 0 =\
      \ apagado\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, samp_rate=24e6, rate=16e3, dur=1e-6, amp=1.0, enable=0):\n\
      \        gr.sync_block.__init__(self, name='Ruido impulsivo EMI',\n        \
      \                       in_sig=None, out_sig=[np.complex64])\n        self.samp_rate\
      \ = samp_rate\n        self.rate = rate\n        self.dur = dur\n        self.amp\
      \ = amp\n        self.enable = enable\n        self._rng = np.random.default_rng(12345)\n\
      \        self._resto = 0  # muestras pendientes de una rafaga que viene del\
      \ buffer anterior\n\n    def work(self, input_items, output_items):\n      \
      \  out = output_items[0]\n        n = len(out)\n        out[:] = 0\n       \
      \ if (not self.enable) or self.amp <= 0:\n            self._resto = 0\n    \
      \        return n\n        L = max(1, int(round(self.dur * self.samp_rate)))\n\
      \        p = min(1.0, self.rate / self.samp_rate)\n        mask = np.zeros(n,\
      \ dtype=bool)\n        mask[:min(self._resto, n)] = True\n        resto = max(self._resto\
      \ - n, 0)\n        for s in np.flatnonzero(self._rng.random(n) < p):\n     \
      \       mask[s:s + L] = True\n            resto = max(resto, s + L - n)\n  \
      \      self._resto = resto\n        m = int(mask.sum())\n        if m:\n   \
      \         ruido = (self._rng.standard_normal(m) + 1j * self._rng.standard_normal(m))\
      \ * (self.amp / np.sqrt(2))\n            out[mask] = ruido.astype(np.complex64)\n\
      \        return n\n"
    affinity: ''
    alias: ''
    amp: emi_amp
    comment: EMI impulsiva Bernoulli-Gaussiana
    dur: emi_dur
    enable: emi_on
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: emi_rate
    samp_rate: samp_rate
  states:
    _io_cache: ('Ruido impulsivo EMI', 'blk', [('samp_rate', '24000000.0'), ('rate',
      '16000.0'), ('dur', '1e-06'), ('amp', '1.0'), ('enable', '0')], [], [('0', 'complex',
      1)], '', ['amp', 'dur', 'enable', 'rate', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1130, 840]
    rotation: 0
    state: enabled
