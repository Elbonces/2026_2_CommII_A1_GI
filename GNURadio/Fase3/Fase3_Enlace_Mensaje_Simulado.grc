- name: lab
  id: epy_module
  parameters:
    source_code: |
      """Utilidades del enlace 16-QAM del grupo A1-GI (Fase 3, laboratorio)."""
      import math

      # Constelacion 16-QAM Gray normalizada (Es = 1): b3b2 -> I, b1b0 -> Q
      TABLA = [p / math.sqrt(10) for p in (-3-3j, -3-1j, -3+3j, -3+1j, -1-3j, -1-1j, -1+3j, -1+1j,
                                             3-3j, 3-1j, 3+3j, 3+1j, 1-3j, 1-1j, 1+3j, 1+1j)]


      def prbs15():
          """Secuencia PRBS15 (x^15 + x^14 + 1), periodo 32767 bits: b[n] = b[n-14] xor b[n-15]."""
          s = [1] * 15
          out = []
          for _ in range(2 ** 15 - 1):
              b = s[13] ^ s[14]
              out.append(s[14])
              s = [b] + s[:-1]
          return out


      def mapa_rotacion(k):
          """Indice del punto que resulta de rotar cada punto k*90 grados."""
          r = []
          for p in TABLA:
              q = p * (1j ** k)
              r.append(min(range(16), key=lambda i: abs(q - TABLA[i])))
          return r


      # ---------------- Tramas de texto (transmisor con mensaje) ----------------
      import zlib as _zlib

      BITS_TRAMA = 8192                 # 2048 simbolos 16-QAM por trama
      MAX_BYTES = (BITS_TRAMA - 64 - 32 - 32) // 8   # 1008 bytes de texto
      import numpy as _np
      SYNC = [int(b) for b in _np.random.RandomState(27145).randint(0, 2, 64)]   # palabra de sincronismo
      _BLANQUEO = None


      def _bits(valor, n):
          return [(valor >> (n - 1 - i)) & 1 for i in range(n)]


      def trama_bits(mensaje):
          """SYNC(64) | blanqueado( LONG(16) | ~LONG(16) | TEXTO | CRC32 | relleno ) = 8192 bits."""
          global _BLANQUEO
          if _BLANQUEO is None:
              _BLANQUEO = prbs15()[:BITS_TRAMA - 64]
          datos = str(mensaje).encode('utf-8')[:MAX_BYTES]
          largo = len(datos)
          cuerpo = _bits(largo, 16) + _bits(largo ^ 0xFFFF, 16)
          for byte in datos:
              cuerpo += _bits(byte, 8)
          cuerpo += _bits(_zlib.crc32(datos) & 0xFFFFFFFF, 32)
          cuerpo += [0] * (BITS_TRAMA - 64 - len(cuerpo))
          return SYNC + [c ^ w for c, w in zip(cuerpo, _BLANQUEO)]


      def trama_bytes(mensaje):
          """La misma trama empaquetada en 1024 bytes (MSB primero). Cada byte = 2 simbolos 16-QAM,
          asi un cambio de mensaje en vivo nunca parte un simbolo por la mitad."""
          b = trama_bits(mensaje)
          return [sum(b[i + j] << (7 - j) for j in range(8)) for i in range(0, len(b), 8)]
    comment: Tabla, PRBS15 y utilidades
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1650
    - 100
    rotation: 0
    state: enabled
