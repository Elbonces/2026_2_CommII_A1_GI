    state: enabled
- name: e_EbN0_Sweep
  id: epy_block
  parameters:
    _source_code: |
      """
      e_EbN0_Sweep
      Instrumento para caracterización BER con un enlace SDR ya funcional.

      Entrada 0 : señal compleja I/Q recibida del SDR (preferiblemente DESPUÉS
                  de la adaptación radio_rate -> bb_rate).
      Salida 0  : la misma señal I/Q con AWGN adicional controlado.
      Salida 1  : valor instantáneo de Eb/N0 [dB] usado en el barrido.

      El bloque NO sustituye el USRP/HackRF ni el receptor. Se inserta entre
      la salida I/Q del SDR y la entrada del receptor digital.

      El barrido se hace por segmentos contiguos. Cada punto se mantiene durante:
          bits_guardia + bits_por_punto

      La potencia de ruido artificial se calcula a partir de la potencia promedio
      medida ANTES de agregar el ruido:

          Eb = Ps / Rb
          N0 = Eb / (Eb/N0)
          Pn = N0 * Fs

      por lo tanto:

          Pn = Ps * Fs / (Rb * 10**(EbN0_dB/10))

      El ruido complejo se genera con varianza total Pn.
      """

      import numpy as np
      from gnuradio import gr


      class blk(gr.sync_block):
          def __init__(self,
                       EbN0_min=0.0,
                       EbN0_max=14.0,
                       EbN0_step=1.0,
                       samp_rate=256000.0,
                       bit_rate=64000.0,
                       bits_por_punto=100000,
                       bits_guardia=1000,
                       signal_power=0.0,
                       seed=2026):
              gr.sync_block.__init__(
                  self,
                  name='e_EbN0_Sweep',
                  in_sig=[np.complex64],
                  out_sig=[np.complex64, np.float32]
              )

              self.EbN0_min = float(EbN0_min)
              self.EbN0_max = float(EbN0_max)
              self.EbN0_step = float(EbN0_step)
              self.samp_rate = float(samp_rate)
              self.bit_rate = float(bit_rate)
              self.bits_por_punto = max(1, int(bits_por_punto))
              self.bits_guardia = max(0, int(bits_guardia))
              self.signal_power_cfg = float(signal_power)

              if self.EbN0_step <= 0:
                  raise ValueError("EbN0_step debe ser > 0")
              if self.samp_rate <= 0 or self.bit_rate <= 0:
                  raise ValueError("samp_rate y bit_rate deben ser > 0")
              if self.EbN0_max < self.EbN0_min:
                  raise ValueError("EbN0_max debe ser >= EbN0_min")

              npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step)) + 1
              self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts, dtype=np.float64)
              self.segment_bits = self.bits_guardia + self.bits_por_punto

              self.sample_count = 0
              self.power_sum = 0.0
              self.power_count = 0
              self.rng = np.random.default_rng(int(seed))

          def _signal_power(self, x):
              if self.signal_power_cfg > 0:
                  return self.signal_power_cfg

              # Promedio acumulado de la señal recibida ANTES del ruido artificial.
              self.power_sum += float(np.sum(np.abs(x.astype(np.complex128))**2))
              self.power_count += len(x)
              if self.power_count <= 0:
                  return 0.0
              return max(self.power_sum/self.power_count, 1e-20)

          def work(self, input_items, output_items):
              x = input_items[0]
              y = output_items[0]
              eb_out = output_items[1]
              n = len(x)
              if n == 0:
                  return 0

              Ps = self._signal_power(x)

              # Índice absoluto de muestra -> índice equivalente de bit.
              s = self.sample_count + np.arange(n, dtype=np.float64)
              bit_index = np.floor(s*self.bit_rate/self.samp_rate).astype(np.int64)

              segment_index = bit_index // self.segment_bits
              point_index = np.mod(segment_index, len(self.eb_axis))
              ebn0_db = self.eb_axis[point_index]
              ebn0_lin = np.power(10.0, ebn0_db/10.0)

              # Potencia total del ruido complejo por muestra.
              noise_power = Ps*self.samp_rate/(self.bit_rate*ebn0_lin)
              sigma_iq = np.sqrt(np.maximum(noise_power, 0.0)/2.0)

              noise = (
                  self.rng.standard_normal(n)*sigma_iq
                  + 1j*self.rng.standard_normal(n)*sigma_iq
              ).astype(np.complex64)

              y[:] = x + noise
              eb_out[:] = ebn0_db.astype(np.float32)

              self.sample_count += n
              return n
    samp_rate: bb_rate
    bit_rate: Rb
    signal_power: '0.0'
    seed: '2026'
    affinity: ''
    alias: ''
    comment: 'AWGN controlado: entre la salida I/Q (a bb_rate) y el receptor digital'
    maxoutbuf: '0'
    minoutbuf: '0'
    EbN0_min: EbN0_min
    EbN0_max: EbN0_max
    EbN0_step: EbN0_step
    bits_por_punto: bits_por_punto
    bits_guardia: bits_guardia
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 700
    rotation: 0
    state: enabled
    _io_cache: ''
- name: curva_teorica_ber
  id: variable
  parameters:
    value: '[math.log10(max((3.0/8.0)*math.erfc(math.sqrt(0.4*10**((EbN0_min+EbN0_step*i)/10.0))), 1e-12)) for i in range(N_EbN0)]'
    comment: '16-QAM Gray en AWGN: Pb = 3/8 erfc(sqrt(0.4 Eb/N0))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 1280
    rotation: 0
    state: enabled
- name: e_Alinea_Ref
  id: epy_block
  parameters:
    _source_code: |
      """
      e_Alinea_Ref  -  Alineacion automatica de las secuencias Tx y Rx (Guia 4, paso 9)

      El transmisor (otro computador) repite una trama conocida de 8192 bits = 2048 simbolos 16-QAM.
      Este bloque regenera esa misma trama en el receptor (parametro 'referencia') y la alinea con
      los simbolos decididos por el receptor, de modo que e_BER_Curve compare bit a bit las dos
      secuencias con delay_bits = 0.

      Entrada 0 : indice de simbolo decidido (0..15) a la salida del Constellation Receiver.
      Salida 0  : simbolo recibido ya corregido de la ambiguedad de fase (0/90/180/270 grados).
      Salida 1  : simbolo de referencia (Tx) alineado con el anterior.
      Salida 2  : desfase encontrado (simbolos, 0..2047)  -> equivale al delay_bits = 4*desfase.
      Salida 3  : rotacion aplicada (0..3).
      Salida 4  : fraccion de simbolos coincidentes en la ultima ventana (0..1).

      Funcionamiento (SIN latencia anadida: cada simbolo sale en cuanto entra, con el desfase y la rotacion que dieron
      las ventanas anteriores):
        1. Busqueda: correlacion circular (FFT) de la ventana recibida con la trama de referencia,
           para los 2048 desfases y las 4 rotaciones. Se acepta si coincide >= 30 % de los simbolos
           (el azar da 6,25 %).
        2. Seguimiento: el desfase queda fijo; cada 256 simbolos se reevalua la rotacion (el lazo de
           portadora puede saltar 90 grados cuando el ruido es alto); se cambia solo si otra rotacion
           coincide >= 25 % mas que la actual.
        3. Si 8 ventanas de seguimiento (2048 simbolos) coinciden menos de 25 %, se vuelve a buscar (salto de simbolo).
           La busqueda solo cambia el enganche si encuentra >= 30 % de coincidencia; en un enlace con mucho ruido
           (BER ~ 0,4) el enganche se conserva y los errores se cuentan.
      Antes del primer enganche las dos salidas son iguales (no se cuentan errores falsos).
      Despues del enganche NUNCA se fuerza la referencia: si el enlace pierde el sincronismo, los
      errores resultantes se cuentan como errores reales.
      """
      import numpy as np
      from gnuradio import gr

      W = 2048          # una trama = 2048 simbolos (periodo de la referencia)
      TRK = 256         # ventana de seguimiento de la rotacion
      NPOBRES = 8       # ventanas de seguimiento pobres (acumuladas) antes de volver a buscar (2048 simbolos)
      TABLA = np.array([-3-3j, -3-1j, -3+3j, -3+1j, -1-3j, -1-1j, -1+3j, -1+1j,
                        3-3j, 3-1j, 3+3j, 3+1j, 1-3j, 1-1j, 1+3j, 1+1j]) / np.sqrt(10)


      def _mapa(k):
          q = TABLA * (1j ** k)
          return np.array([np.argmin(np.abs(TABLA - v)) for v in q], dtype=np.uint8)


      class blk(gr.sync_block):
          def __init__(self, referencia=None, umbral_enganche=0.30, umbral_pobre=0.25):
              gr.sync_block.__init__(self, name='e_Alinea_Ref', in_sig=[np.uint8],
                                     out_sig=[np.uint8, np.uint8, np.float32, np.float32, np.float32])
              if referencia is None:
                  referencia = [0] * 1024      # solo para que GRC pueda leer la firma del bloque
              bits = np.unpackbits(np.array(referencia, dtype=np.uint8))
              assert len(bits) == 4 * W, 'la referencia debe tener 8192 bits (1024 bytes)'
              self.REF = (bits.reshape(-1, 4) * np.array([8, 4, 2, 1])).sum(1).astype(np.uint8)
              self.MAPAS = [_mapa(k) for k in range(4)]
              self.umbral_enganche = float(umbral_enganche)
              self.umbral_pobre = float(umbral_pobre)
              v = np.arange(16, dtype=np.uint8)[:, None]
              self.FB = np.fft.fft((self.REF[None, :] == v).astype(np.float64), axis=1)
              self.V = v
              self.enganchado = False
              self.s = 0
              self.r = 0
              self.match = 0.0
              self.pobres = 0
              self.buf = np.zeros(0, dtype=np.uint8)
              self.trk = np.zeros(0, dtype=np.uint8)
              self.n_trk = 0
              self.p = 0                                      # indice absoluto de simbolo

          def _buscar(self, x):
              mejor = (-1.0, 0, 0)
              for k in range(4):
                  y = self.MAPAS[k][x]
                  FA = np.fft.fft((y[None, :] == self.V).astype(np.float64), axis=1)
                  c = np.fft.ifft(np.conj(FA) * self.FB, axis=1).real.sum(axis=0)
                  s = int(np.argmax(c))
                  if c[s] > mejor[0]:
                      mejor = (float(c[s]), s, k)
              return mejor[0] / W, mejor[1], mejor[2]

          def _ref_en(self, q0, n):
              """Simbolos de referencia para los indices absolutos q0..q0+n-1."""
              return self.REF[(q0 + np.arange(n) + self.s) % W]

          def _buscar_buffer(self):
              """Busqueda global sobre los ultimos W simbolos recibidos."""
              x = self.buf
              m, s, k = self._buscar(x)
              if m >= self.umbral_enganche:
                  inicio = self.p - W                       # indice absoluto del primer simbolo del buffer
                  return m, (s - inicio) % W, k
              return m, None, None

          def _seguimiento(self, x):
              """x: ultimos TRK simbolos (ya incluidos en el buffer). Actualiza rotacion / reenganche."""
              q0 = self.p - len(x)
              ref = self._ref_en(q0, len(x))
              coin = [float((self.MAPAS[k][x] == ref).mean()) for k in range(4)]
              mejor = int(np.argmax(coin))
              if coin[mejor] > coin[self.r] + 0.25:
                  self.r = mejor
              self.match = coin[self.r]
              if self.match < self.umbral_pobre:
                  self.pobres += 1
              else:
                  self.pobres = max(0, self.pobres - 2)

          def work(self, input_items, output_items):
              n = len(input_items[0])
              x = input_items[0] & 0x0F
              a = 0
              while a < n:
                  b = min(n, a + TRK - len(self.trk))
                  seg = x[a:b]
                  if self.enganchado:
                      output_items[0][a:b] = self.MAPAS[self.r][seg]
                      output_items[1][a:b] = self._ref_en(self.p, len(seg))
                  else:                                       # antes del primer enganche: sin errores falsos
                      output_items[0][a:b] = seg
                      output_items[1][a:b] = seg
                  self.p += len(seg)
                  self.buf = np.concatenate([self.buf, seg])[-W:]
                  self.trk = np.concatenate([self.trk, seg])
                  if len(self.trk) == TRK:
                      if self.enganchado:
                          self._seguimiento(self.trk)
                      self.trk = np.zeros(0, dtype=np.uint8)
                      self.n_trk += 1
                      if len(self.buf) == W and self.n_trk % (W // TRK) == 0 and \
                              (not self.enganchado or self.pobres >= NPOBRES):
                          m, s_abs, k = self._buscar_buffer()
                          if s_abs is not None:
                              self.enganchado, self.s, self.r, self.match, self.pobres = True, s_abs, k, m, 0
                          elif not self.enganchado:
                              self.match = 0.0
                  a = b
              output_items[2][:] = self.s
              output_items[3][:] = self.r
              output_items[4][:] = self.match
              return n
    referencia: lab.trama_bytes(mensaje_ref)
    umbral_enganche: '0.30'
    umbral_pobre: '0.25'
    affinity: ''
    alias: ''
    comment: Regenera la trama Tx conocida y la alinea con los simbolos recibidos (corrige desfase y ambiguedad de 90 grados)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 1450
    rotation: 0
    state: enabled
    _io_cache: ''
- name: e_SER_Curve
  id: epy_block
  parameters:
    _source_code: |
      """
      e_SER_Curve - Acumulador de curva SER (tasa de error de SIMBOLO) 16-QAM.
      Adaptacion de e_BER_Curve: compara simbolos (0..15) en lugar de bits.

      Entrada 0 : simbolo Tx de referencia (0..15), salida 1 de e_Alinea_Ref.
      Entrada 1 : simbolo decidido por el receptor (0..15), salida 0 de e_Alinea_Ref.

      Salida 0  : vector SER lineal.
      Salida 1  : vector log10(SER) para QT GUI Vector Sink.

      El bloque usa exactamente el mismo barrido que e_EbN0_Sweep. Para cada punto:
      - ignora simbolos_guardia al comienzo del segmento;
      - compara simbolos_por_punto;
      - cuando el barrido vuelve a un punto, sigue acumulando estadísticas.

      delay_bits retrasa internamente la referencia Tx para compensar el retardo
      del receptor. Se ajusta primero en una condición limpia hasta lograr BER≈0.

      Cuando todavía no se observa ningún error, la salida logarítmica utiliza
      3/N como cota superior aproximada para poder mostrar el punto sin afirmar
      que BER=0.
      """

      import numpy as np
      from gnuradio import gr


      class blk(gr.decim_block):
          def __init__(self,
                       EbN0_min=0.0,
                       EbN0_max=14.0,
                       EbN0_step=1.0,
                       simbolos_por_punto=25000,
                       simbolos_guardia=5000,
                       delay_simbolos=0,
                       update_every=1000):
              self.EbN0_min = float(EbN0_min)
              self.EbN0_max = float(EbN0_max)
              self.EbN0_step = float(EbN0_step)
              self.simbolos_por_punto = max(1, int(simbolos_por_punto))
              self.simbolos_guardia = max(0, int(simbolos_guardia))
              self.delay_simbolos = max(0, int(delay_simbolos))
              self.update_every = max(1, int(update_every))

              if self.EbN0_step <= 0:
                  raise ValueError("EbN0_step debe ser > 0")
              if self.EbN0_max < self.EbN0_min:
                  raise ValueError("EbN0_max debe ser >= EbN0_min")

              npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step)) + 1
              self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts, dtype=np.float64)
              self.N = len(self.eb_axis)
              self.segment_bits = self.simbolos_guardia + self.simbolos_por_punto

              gr.decim_block.__init__(
                  self,
                  name='e_SER_Curve',
                  in_sig=[np.uint8, np.uint8],
                  out_sig=[(np.float32, self.N), (np.float32, self.N)],
                  decim=self.update_every
              )

              self.carry = np.zeros(self.delay_simbolos, dtype=np.uint8)
              self.raw_items = 0
              self.valid_bit_index = 0

              self.count = np.zeros(self.N, dtype=np.int64)
              self.errors = np.zeros(self.N, dtype=np.int64)

          def _process(self, tx, rx):
              # Un simbolo es erroneo si el indice decidido difiere del transmitido.
              tb = (np.asarray(tx, dtype=np.int64) & 15).astype(np.uint8)
              rb = (np.asarray(rx, dtype=np.int64) & 15).astype(np.uint8)
              n = len(tb)
              if self.delay_simbolos > 0:
                  lleno = np.concatenate([self.carry, tb])
                  ta = lleno[:n]
                  self.carry = lleno[n:]
                  salto = min(n, max(0, self.delay_simbolos - self.raw_items))
                  ta, rb = ta[salto:], rb[salto:]
              else:
                  ta = tb
              self.raw_items += n
              m = len(ta)
              if m == 0:
                  return
              idx = self.valid_bit_index + np.arange(m, dtype=np.int64)
              punto = (idx // self.segment_bits) % self.N
              pos = idx % self.segment_bits
              ok = pos >= self.simbolos_guardia
              self.count += np.bincount(punto[ok], minlength=self.N)
              self.errors += np.bincount(punto[ok & (ta != rb)], minlength=self.N)
              self.valid_bit_index += m

          def _vectors(self):
              ser = np.zeros(self.N, dtype=np.float32)
              logser = np.zeros(self.N, dtype=np.float32)

              for i in range(self.N):
                  n = int(self.count[i])
                  e = int(self.errors[i])

                  if n <= 0:
                      ser[i] = 0.0
                      logser[i] = 0.0
                  elif e > 0:
                      b = e/float(n)
                      ser[i] = b
                      logser[i] = np.log10(max(b, 1e-12))
                  else:
                      # SER observado = 0; para la gráfica usamos una cota superior.
                      ser[i] = 0.0
                      upper = min(1.0, 3.0/float(n))
                      logser[i] = np.log10(max(upper, 1e-12))

              return ser, logser

          def work(self, input_items, output_items):
              tx = input_items[0]
              rx = input_items[1]
              out_ber = output_items[0]
              out_log = output_items[1]

              nout = len(out_ber)
              D = self.update_every

              for k in range(nout):
                  a = k*D
                  b = min((k+1)*D, len(tx))
                  if a < b:
                      self._process(tx[a:b], rx[a:b])

                  ser, logser = self._vectors()
                  out_ber[k, :] = ser
                  out_log[k, :] = logser

              return nout
    delay_simbolos: delay_simbolos
    update_every: update_every
    affinity: ''
    alias: ''
    comment: Compara simbolos Tx/Rx y acumula SER por punto
    maxoutbuf: '0'
    minoutbuf: '0'
    EbN0_min: EbN0_min
    EbN0_max: EbN0_max
    EbN0_step: EbN0_step
    simbolos_por_punto: simbolos_por_punto
    simbolos_guardia: simbolos_guardia
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 1460
    rotation: 0
    state: enabled
    _io_cache: ''
