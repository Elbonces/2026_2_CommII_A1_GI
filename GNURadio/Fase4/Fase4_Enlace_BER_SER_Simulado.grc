- name: ber_prbs
  id: epy_block
  parameters:
    _source_code: |
      """
      Decodificador de tramas de texto para el enlace 16-QAM (grupo A1-GI).

      Trama del transmisor (8192 bits = 2048 simbolos 16-QAM):
        SYNC (64 bits) | blanqueado( LONG(16) | ~LONG(16) | TEXTO UTF-8 | CRC32(32) | ceros de relleno )
      El blanqueado es un XOR con la secuencia PRBS15: mantiene la senal "aleatoria" aunque el texto
      se repita (espectro plano y transiciones para el sincronismo de simbolo).

      Entrada: indices de simbolo decididos (0..15) a la salida del Constellation Receiver.
      El lazo de portadora puede engancharse girado 0/90/180/270 grados: la palabra SYNC se busca en
      las cuatro rotaciones y la que aparece fija la rotacion con que se leen las tramas.

      Salidas (float, una muestra por simbolo):
        0: tramas correctas (CRC bien)   1: tramas con error
        2: BER medido sobre bits conocidos (SYNC + relleno)   3: rotacion detectada (0..3)
      Puerto de mensaje 'texto': ultimo mensaje recibido con CRC correcto.
      """
      import zlib
      import numpy as np
      import pmt
      from gnuradio import gr

      TABLA = np.array([-3-3j, -3-1j, -3+3j, -3+1j, -1-3j, -1-1j, -1+3j, -1+1j,
                        3-3j, 3-1j, 3+3j, 3+1j, 1-3j, 1-1j, 1+3j, 1+1j]) / np.sqrt(10)
      BITS_TRAMA = 8192
      SIMB_TRAMA = BITS_TRAMA // 4


      def _mapa(k):
          q = TABLA * (1j ** k)
          return np.array([np.argmin(np.abs(TABLA - v)) for v in q], dtype=np.uint8)


      def _prbs15(n):
          s = [1] * 15
          out = []
          for _ in range(n):
              b = s[13] ^ s[14]
              out.append(s[14])
              s = [b] + s[:-1]
          return np.array(out, dtype=np.uint8)


      SYNC = np.random.RandomState(27145).randint(0, 2, 64).astype(np.uint8)
      SYNC_SIMB = (SYNC.reshape(-1, 4) * np.array([8, 4, 2, 1])).sum(1).astype(np.uint8)
      BLANQUEO = _prbs15(BITS_TRAMA - 64)
      PESOS = np.array([3, 2, 1, 0], dtype=np.uint8)


      def _entero(bits):
          v = 0
          for b in bits:
              v = (v << 1) | int(b)
          return v


      class blk(gr.sync_block):
          def __init__(self, ventana_tramas=50):
              gr.sync_block.__init__(self, name='Decodificador de mensajes 16-QAM',
                                     in_sig=[np.uint8], out_sig=[np.float32] * 4)
              self.message_port_register_out(pmt.intern('texto'))
              self.ventana_tramas = ventana_tramas
              self._mapas = [_mapa(k) for k in range(4)]
              self._buf = np.zeros(0, dtype=np.uint8)
              self._enganchado = False
              self._rot = 0
              self._malas = 0
              self._ok = 0
              self._mal = 0
              self._err = 0
              self._nb = 0
              self._tramas_ventana = 0
              self._ber = 0.5
              self._ultimo = None

          def _buscar(self):
              mejor = None
              if len(self._buf) < 16:
                  return None
              for k in range(4):
                  t = self._mapas[k][self._buf]
                  v = np.lib.stride_tricks.sliding_window_view(t, 16)
                  aciertos = (v == SYNC_SIMB).sum(axis=1)
                  i = int(np.argmax(aciertos))
                  if aciertos[i] >= 13 and (mejor is None or aciertos[i] > mejor[2] or
                                            (aciertos[i] == mejor[2] and i < mejor[0])):
                      mejor = (i, k, int(aciertos[i]))
              return mejor

          def _decodificar(self, trama):
              idx = self._mapas[self._rot][trama]
              bits = ((idx[:, None] >> PESOS) & 1).astype(np.uint8).ravel()
              err_sync = int((bits[:64] ^ SYNC).sum())
              cuerpo = bits[64:] ^ BLANQUEO
              largo, largo_c = _entero(cuerpo[:16]), _entero(cuerpo[16:32])
              err, nb = err_sync, 64
              valida = False
              if (largo ^ largo_c) == 0xFFFF and 32 + 8 * largo + 32 <= len(cuerpo):
                  fin = 32 + 8 * largo
                  datos = np.packbits(cuerpo[32:fin]).tobytes()
                  crc = _entero(cuerpo[fin:fin + 32])
                  relleno = cuerpo[fin + 32:]
                  err += int(relleno.sum())
                  nb += len(relleno)
                  if zlib.crc32(datos) & 0xFFFFFFFF == crc:
                      valida = True
                      texto = datos.decode('utf-8', errors='replace')
                      if texto != self._ultimo:
                          self._ultimo = texto
                          print('Mensaje recibido:', texto, flush=True)
                          self.message_port_pub(pmt.intern('texto'), pmt.intern(texto))
              if valida:
                  self._ok += 1
              else:
                  self._mal += 1
              self._err += err
              self._nb += nb
              self._tramas_ventana += 1
              if self._tramas_ventana >= self.ventana_tramas:
                  self._ber = self._err / max(self._nb, 1)
                  self._err = self._nb = self._tramas_ventana = 0
              # Perdida de enganche: SYNC muy danada en tres tramas seguidas
              self._malas = self._malas + 1 if err_sync > 16 else 0
              if self._malas >= 3:
                  self._enganchado = False
                  self._malas = 0

          def work(self, input_items, output_items):
              sym = input_items[0] & 0x0F
              n = len(sym)
              self._buf = np.concatenate([self._buf, sym])
              while True:
                  if not self._enganchado:
                      hallado = self._buscar()
                      if hallado is None:
                          self._buf = self._buf[-15:]
                          break
                      self._buf = self._buf[hallado[0]:]
                      self._rot = hallado[1]
                      self._enganchado = True
                  if len(self._buf) < SIMB_TRAMA:
                      break
                  trama, self._buf = self._buf[:SIMB_TRAMA], self._buf[SIMB_TRAMA:]
                  self._decodificar(trama)
              output_items[0][:] = self._ok
              output_items[1][:] = self._mal
              output_items[2][:] = self._ber
              output_items[3][:] = self._rot
              return n
    ventana_tramas: '50'
    affinity: ''
    alias: ''
    comment: Busca la palabra SYNC en las 4 rotaciones, verifica CRC32 y entrega el texto
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1330
    - 880
    rotation: 0
    state: enabled
